{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron supervisor for an independent local Harness runtime with the Bid Studio bundle",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "files": ["lib/*.js"],
  "scripts": {
    "start": "electron lib/main.js",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-bid-studio-bundle": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "42.5.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.deepseek.harness.bidstudio",
    "productName": "DeepSeek Bid Studio",
    "asar": true,
    "files": ["lib/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  }
}
