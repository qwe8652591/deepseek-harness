            >
              <span
                class="workbenchLabel"
              >
                Cowork
              </span>
            </button>
            <button
              aria-current="page"
              aria-label="Code"
              class=""
              type="button"
            >
              <span
                class="workbenchLabel"
              >
                Code
              </span>
            </button>
          </nav>
          <div
            data-slot="sidebar.workbench.navigation"
            style="display: contents;"
          >
            <button
              aria-label="New session"
              class="newSession"
              type="button"
            >
              <svg
                data-content="c0ce4dcc"
                fill="none"
                height="14"
