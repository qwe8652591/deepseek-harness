                      />
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <div>
              <div
                data-slot="workbench.conversation.message"
                style="display: contents;"
              >
                <div
                  class="root"
                >
                  <div
                    class="body"
                  >
                    <div
                      class="markdown"
                    >
                      <p>
                        It returns 
                        <strong>
                          42
                        </strong>
                        .
                      </p>
                      

                      <div
                        class="block md-code-block"
                      >
                        <div
                          class="bannerWrap"
                        >
                          <div
                            class="banner"
                            data-code-block-banner="true"
                          >
                            <div
                              class="infostring"
                            >
                              ts
                            </div>
                            <div
                              class="action"
                            >
                              <button
                                class="copyButton"
                                type="button"
                              >
                                copy
                              </button>
                            </div>
                          </div>
                        </div>
                        <div>
                          <pre
                            class="shiki css-variables"
                            style="background-color:var(--shiki-background);color:var(--shiki-foreground)"
                            tabindex="0"
                          >
                            <code>
                              <span
                                class="line"
                              >
                                <span
                                  style="color:var(--shiki-token-keyword)"
                                >
                                  return
                                </span>
                                <span
                                  style="color:var(--shiki-token-constant)"
                                >
                                   42
                                </span>
                              </span>
                            </code>
                          </pre>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="composer"
        >
          <div
            class="path"
          >
            /project
          </div>
          <div
            class="root"
          >
            <div
