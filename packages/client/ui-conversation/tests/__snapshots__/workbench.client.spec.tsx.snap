// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders engine messages with native Markdown, copy actions, and composer keyboard guards 1`] = `
<div>
  <div
    data-slot="root"
    style="display: contents;"
  >
    <div
      data-slot="workbench.conversation"
