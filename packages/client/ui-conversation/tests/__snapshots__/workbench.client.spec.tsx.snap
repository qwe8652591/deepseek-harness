            Ready
          </span>
        </header>
        <div
          class="scroll"
        >
          <div
            class="transcript"
          >
            <div>
              <div
                data-slot="workbench.conversation.message"
                style="display: contents;"
              >
                <div
                  class="userRow"
                >
                  <div
                    class="userStack"
                  >
                    <div
                      class="bubble"
                    >
                      <span
